# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Variables already set in your shell take precedence over this file.

# --- Model ------------------------------------------------------------------
# A LiteLLM "provider/model" string by default: openai/<model>, anthropic/<model>,
# gemini/<model>, deepseek/<model>, azure/<deployment>, ollama/<model>.
# If HARNESS_LOCAL_MODEL=true below, this is instead the plain model id your
# local server reports, with no "provider/" prefix, e.g. llama-3.1-8b-instruct.
HARNESS_MODEL=

# --- Provider keys: set the one(s) for the provider you use ------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Azure OpenAI also needs:
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# --- Local model (optional) --------------------------------------------------
# Talk directly to a local OpenAI-compatible server (Ollama, vLLM, llama.cpp,
# LM Studio, text-generation-webui, ...) instead of going through LiteLLM.
# Requires: pip install -e '.[local]'   (adds `instructor` + `openai`)
HARNESS_LOCAL_MODEL=false
# Required when HARNESS_LOCAL_MODEL=true: the server's OpenAI-compatible base URL.
#   Ollama:          http://localhost:11434/v1
#   vLLM (default):  http://localhost:8000/v1
#   LM Studio:       http://localhost:1234/v1
HARNESS_API_BASE=
# Optional even in local mode: most local servers ignore it. Used as a LiteLLM
# custom-endpoint key (gateway/proxy) when HARNESS_LOCAL_MODEL=false.
HARNESS_API_KEY=

# --- Sampling -----------------------------------------------------------------
# Left blank by default to use the model's own recommended default -- forcing
# some models (e.g. Gemini 3) below their default temperature degrades them.
HARNESS_TEMPERATURE=
HARNESS_MAX_TOKENS=
HARNESS_MAX_STEPS=15
# Seconds per LLM request -- also used as the per-call timeout (agent.limits.llm_timeout).
HARNESS_TIMEOUT=120

# --- Reliability (Phase 2) -----------------------------------------------------
# Retries a failed LLM call (rate limits, server errors, timeouts) with backoff.
HARNESS_MAX_RETRIES=3
# Overall wall-clock budget for one question/turn. Blank = unlimited.
HARNESS_MAX_EXECUTION_TIME=300
# If the model calls the same tool with the same arguments this many times in a
# row, either "warn" (remind it) or "stop" (fail the run) -- see HARNESS_REPEAT_CALL_ACTION.
HARNESS_REPEAT_CALL_THRESHOLD=3
HARNESS_REPEAT_CALL_ACTION=warn

# --- Context management (Phase 3) ----------------------------------------------
# Soft cap on estimated prompt tokens; the oldest tool-call/result exchanges are
# dropped to fit. Blank = unlimited (send everything, as in Phase 1).
HARNESS_MAX_CONTEXT_TOKENS=10000
# Headroom reserved for the model's reply when HARNESS_MAX_CONTEXT_TOKENS is set.
HARNESS_RESERVED_OUTPUT_TOKENS=1024

# --- Logging ------------------------------------------------------------------
# DEBUG (arguments, results, request sizes), INFO (every step), WARNING, ERROR.
# `python main.py -v` forces DEBUG; `-q` shows warnings only.
HARNESS_LOG_LEVEL=INFO
# Also write logs to this file (appended).
HARNESS_LOG_FILE=
