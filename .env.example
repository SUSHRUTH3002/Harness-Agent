# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Variables already set in your shell take precedence over this file.

# --- Model ------------------------------------------------------------------
# A LiteLLM "provider/model" string by default: openai/<model>, anthropic/<model>,
# gemini/<model>, deepseek/<model>, azure/<deployment>, ollama/<model>.
# If HARNESS_LOCAL_MODEL=true below, this is instead the plain model id your
# local server reports, with no "provider/" prefix, e.g. llama-3.1-8b-instruct.
HARNESS_MODEL=

# --- Provider keys: set the one(s) for the provider you use ------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Azure OpenAI also needs:
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# --- Local model (optional) --------------------------------------------------
# Talk directly to a local OpenAI-compatible server (Ollama, vLLM, llama.cpp,
# LM Studio, text-generation-webui, ...) instead of going through LiteLLM.
# Requires: pip install -e '.[local]'   (adds `instructor` + `openai`)
HARNESS_LOCAL_MODEL=false
# Required when HARNESS_LOCAL_MODEL=true: the server's OpenAI-compatible base URL.
#   Ollama:          http://localhost:11434/v1
#   vLLM (default):  http://localhost:8000/v1
#   LM Studio:       http://localhost:1234/v1
HARNESS_API_BASE=
# Optional even in local mode: most local servers ignore it. Used as a LiteLLM
# custom-endpoint key (gateway/proxy) when HARNESS_LOCAL_MODEL=false.
HARNESS_API_KEY=

# --- Sampling -----------------------------------------------------------------
# Left blank by default to use the model's own recommended default -- forcing
# some models (e.g. Gemini 3) below their default temperature degrades them.
HARNESS_TEMPERATURE=
HARNESS_MAX_TOKENS=
HARNESS_MAX_STEPS=15
# Seconds per LLM request -- also used as the per-call timeout (agent.limits.llm_timeout).
HARNESS_TIMEOUT=120

# --- Reliability (Phase 2) -----------------------------------------------------
# Retries a failed LLM call (rate limits, server errors, timeouts) with backoff.
HARNESS_MAX_RETRIES=3
# Overall wall-clock budget for one question/turn. Blank = unlimited.
HARNESS_MAX_EXECUTION_TIME=300
# If the model calls the same tool with the same arguments this many times in a
# row, either "warn" (remind it) or "stop" (fail the run) -- see HARNESS_REPEAT_CALL_ACTION.
HARNESS_REPEAT_CALL_THRESHOLD=3
HARNESS_REPEAT_CALL_ACTION=warn

# --- Context management (Phase 3) ----------------------------------------------
# Soft cap on estimated prompt tokens; the oldest tool-call/result exchanges are
# dropped to fit. Blank = unlimited (send everything, as in Phase 1).
HARNESS_MAX_CONTEXT_TOKENS=10000
# Headroom reserved for the model's reply when HARNESS_MAX_CONTEXT_TOKENS is set.
HARNESS_RESERVED_OUTPUT_TOKENS=1024

# --- Large result handling (Phase 7) --------------------------------------------
# Whether to enable large result handling. Set to false to disable entirely.
HARNESS_LARGE_RESULT_HANDLING=true
# Maximum estimated tokens for a single call's result before offloading.
HARNESS_LARGE_RESULT_PER_CALL_TOKENS=6000
# Maximum estimated tokens for all results in a single step before offloading.
HARNESS_LARGE_RESULT_PER_STEP_TOKENS=10000
# Characters shown from the start and the end of an offloaded result.
HARNESS_LARGE_RESULT_PREVIEW_CHARS=100
# Where offloaded results are written. Default: an ".artifacts" folder next to main.py.
HARNESS_ARTIFACT_DIR=
# Most characters one read_artifact call returns (one "page"). Bigger = fewer calls to read
# a whole artifact, but each page costs more context. Searches return half this.
HARNESS_ARTIFACT_READ_MAX_CHARS=4000

# --- Compaction (Phase 10) -------------------------------------------------------
# Keeps long sessions (debugging, incident RCA) in budget: when the conversation reaches
# HARNESS_COMPACTION_TRIGGER of HARNESS_MAX_CONTEXT_TOKENS, the older middle part is archived
# to HARNESS_ARTIFACT_DIR word for word and replaced by a summary. Needs HARNESS_MAX_CONTEXT_TOKENS
# (e.g. 150000); without it, compaction only runs when the provider rejects a request as too long.
HARNESS_COMPACTION=true
# Share of the budget that triggers compaction.
HARNESS_COMPACTION_TRIGGER=0.8
# Share of the budget kept word for word as the most recent messages.
HARNESS_COMPACTION_KEEP_RECENT=0.3
# Model that writes the summaries. Blank = the chat model (HARNESS_MODEL).
HARNESS_COMPACTION_MODEL=
# Most tokens one summary may use.
HARNESS_COMPACTION_SUMMARY_MAX_TOKENS=4096

# --- Parallel tool execution (Phase 12) ------------------------------------------
# When the model asks for several tools in one response, tools marked concurrency_safe run at
# the same time; any other tool runs alone, after everything before it. false = all in order.
HARNESS_PARALLEL_TOOLS=true
# Most tools running at once within one response (a sliding pool). 1 = sequential.
HARNESS_MAX_PARALLEL_TOOLS=10
# Optional cap across ALL runs in this process (e.g. many chats on one server). Blank = none.
HARNESS_MAX_PARALLEL_TOOLS_TOTAL=

# --- Logging ------------------------------------------------------------------
# DEBUG (arguments, results, request sizes), INFO (every step), WARNING, ERROR.
# `python main.py -v` forces DEBUG; `-q` shows warnings only.
HARNESS_LOG_LEVEL=INFO
# Also write logs to this file (appended).
HARNESS_LOG_FILE=
